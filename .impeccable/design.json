  "narrative": {
    "northStar": "Cinematic streaming",
    "overview": "The approved world is an understated charcoal cinema with warm coral controls and real film artwork. Bold, closely spaced headings provide direction while the quiet surrounding interface gives posters and photographs room to carry the mood.\n\nOne visual identity serves Waken, Kristine, and Guest. Their account content remains individual. This document records the implemented system from `dist/cinematic.css` and its supporting HTML and stylesheet cascade; the first-surface composition belongs in `.impeccable/cinematic-surfaces.md`.",
    "keyCharacteristics": [
      "Charcoal surfaces and restrained coral emphasis.",
      "Manrope headings with DM Sans reading text and controls.",
      "Real movie imagery, softly rounded artwork, and clear action labels.",
      "Shared visual identity with account-specific content."
    ],
    "rules": [
      {
        "name": "The Shared Cinema Rule",
        "body": "Keep the charcoal and coral identity consistent across all member profiles; personalization belongs to content and account state.",
        "section": "colors"
      },
      {
        "name": "The Artwork First Rule",
        "body": "Use contrast and tonal separation to frame the film artwork; do not add decorative glow to cards or rank labels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the shared charcoal and coral identity across all three profiles.",
      "**Do** use real title artwork and actual per-account viewing progress.",
      "**Do** preserve visible keyboard focus, readable metadata, and explicit loading, empty, and retry states.",
      "**Do** keep login and dashboard as separate screens."
    ],
    "donts": [
      "**Don't** turn illustrative mockup titles, artwork, or progress into fabricated account activity.",
      "**Don't** restore personal color themes, glowing ranks, or decorative pulses.",
      "**Don't** replace real movie imagery with the approved mockup's illustrative placeholders."
    ]
  }
}
